# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv*/
venv/
.ipynb_checkpoints/

# Данные и артефакты экспериментов
data/
checkpoints/
runs/
outputs/
wandb/
*.ckpt
*.pt
*.pth

# Логи планировщика
slurm-*.out
*.log

# Окружение
.env
.DS_Store

# LaTeX build artifacts. Scoped to paper/ on purpose: an unscoped *.out would also
# swallow unrelated files, and the reference PDFs in "developer files/" are tracked,
# so *.pdf must never be ignored repo-wide.
paper/build/
paper/**/*.aux
paper/**/*.bbl
paper/**/*.blg
paper/**/*.fdb_latexmk
paper/**/*.fls
paper/**/*.out
paper/**/*.synctex.gz
paper/**/*.toc
paper/**/*.lof
paper/**/*.lot

# paper/main.pdf is deliberately NOT ignored: it is the milestone artifact, produced by
# `make release` and committed only when a specific PDF matters (a version sent to a
# supervisor, a tagged draft). Everyday builds go to paper/build/, which is ignored above.
# Builds are byte-reproducible (see paper/Makefile), so re-committing an unchanged paper
# costs nothing -- git sees no change at all.
